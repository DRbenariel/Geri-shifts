// Cloudflare Worker for the ui-v2 site: static assets from ./out, plus worker/index.js proxying /api/* to Cloud Run.
// Set the API address with:  npx wrangler secret put API_ORIGIN   (or a plain var in the dashboard)
{
  "name": "geri-shifts",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
